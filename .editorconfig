# EditorConfig — https://editorconfig.org
# Complements the repo-wide line-ending policy in .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Windows-only scripts keep CRLF (matches .gitattributes)
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Markdown uses trailing spaces for hard line breaks
[*.md]
trim_trailing_whitespace = false

# Vendored / generated bundles — leave upstream formatting untouched
[assets/vendor/**]
trim_trailing_whitespace = false
insert_final_newline = false
