# Normalise line endings repo-wide.
# Detect text vs binary; text is stored and checked out as LF unless overridden.
# This rule is what makes the machine-level core.autocrlf=true irrelevant here:
# per gitattributes(5), `eol` is consulted before core.autocrlf/core.eol.
* text=auto eol=lf

# ── Explicit text-with-LF (must work on Linux CI runners) ──────────
*.js          text eol=lf
*.cjs         text eol=lf
*.mjs         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.svg         text eol=lf
*.sh          text eol=lf
*.cfg         text eol=lf
*.toml        text eol=lf
*.txt         text eol=lf
Makefile      text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
.mailmap      text eol=lf

# ── Extensionless tracked files: pinned so nothing relies on the `*` fallback ─
.editorconfig text eol=lf
.nvmrc        text eol=lf
LICENSE       text eol=lf
CODEOWNERS    text eol=lf

# ── Installer sources: consumed by Inno Setup / NSIS, LF is correct ─
*.iss         text eol=lf
*.pas         text eol=lf
*.nsh         text eol=lf
*.plist       text eol=lf

# ── Windows-only scripts: keep CRLF (matches .editorconfig) ────────
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# ── Binary — never EOL-normalise, never diff as text ──────────────
# (`binary` is the built-in macro for `-diff -merge -text`.)
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.bmp         binary
*.ico         binary
*.icns        binary
*.pdf         binary
*.zip         binary
*.gz          binary
*.tar         binary
*.exe         binary
*.dll         binary
*.so          binary
*.dylib       binary
*.AppImage    binary
*.dmg         binary
*.deb         binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.otf         binary
*.eot         binary
*.webp        binary
*.avif        binary
*.wasm        binary
# Electron/Chromium payload types. None are tracked today, but `text=auto` sniffs
# .pak and .node wrong often enough that relying on the fallback is a latent bug.
*.pak         binary
*.dat         binary
*.bin         binary
*.node        binary
*.asar        binary
*.msi         binary
*.7z          binary
*.xz          binary
*.bz2         binary

# The working copy is NUL-free (the PH sentinel uses `\u0000` escapes), but
# revisions committed before that fix embed literal NUL bytes, so content
# sniffing renders any history-crossing diff as "Binary files differ". Setting
# `diff` keeps `git log -p` readable across the whole history — gitattributes(5):
# a path with `diff` set "is treated as text, even when they contain byte values
# that normally never appear in text files, such as NUL".
scripts/rem-convert.mjs  text eol=lf diff

# ── Lockfile: collapsed in the GitHub PR UI, still diffable locally ─
# `linguist-generated=true` alone hides it on GitHub ("Excluded from stats,
# hidden in diffs"). `-diff` is deliberately NOT set — it would make local
# `git diff` and `git add -p` useless on the supply-chain-critical file.
package-lock.json  text eol=lf linguist-generated=true

# Generated from exact package-lock sources by scripts/sync-vendor.js. Some
# upstream template literals intentionally contain trailing spaces.
resources/vendor/**/*.min.js text eol=lf linguist-generated=true whitespace=-trailing-space

# ── Vendored third-party runtime ────────────────────────────────────────────
# `linguist-generated` above only matches *.min.js, which let two vendored files
# through: marked.umd.js (43 KB) and katex.min.css (24 KB — a fifth of every CSS
# byte in the repo). Both were counted as first-party code in GitHub's language
# stats and rendered expanded in every diff. `linguist-vendored` is also the more
# accurate marker for code that is third-party rather than machine-generated; the
# narrower eol/whitespace rules above still apply on top of it.
resources/vendor/** linguist-vendored=true

# ── Playwright visual baselines ─────────────────────────────────────────────
# 34 files / 6 MiB, the heaviest tracked category and the one that rewrites on
# every visual-regression update. `binary` (from *.png above) already suppresses
# the textual diff; `linguist-generated` additionally collapses them in the PR UI
# so a baseline refresh does not bury the code it accompanies.
tests/e2e/**-snapshots/*.png linguist-generated=true

# ── Source-archive exclusions ───────────────────────────────────────────────
# `git archive` — which is what GitHub serves for "Download ZIP" and for release
# source tarballs — shipped the whole test suite (245 .js plus 6 MiB of PNGs),
# the CI definitions, and the threshold configs. None of that is needed to build
# or run the app, and it was roughly a third of the tarball.
tests/          export-ignore
.github/        export-ignore
config/         export-ignore
.editorconfig   export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.mailmap        export-ignore
.nvmrc          export-ignore
.syft.yaml      export-ignore
stryker.config.json         export-ignore
vitest.config.js            export-ignore
vitest.mutation.config.js   export-ignore
playwright.config.js        export-ignore
playwright.electron.config.js export-ignore
