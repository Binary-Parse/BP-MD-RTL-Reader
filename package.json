{
  "name": "marqam",
  "version": "1.0.0",
  "description": "Marqam markdown editor with RTL support",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.js",
    "test:unit:coverage": "vitest run --config vitest.config.js --coverage",
    "test:e2e": "playwright test --config playwright.config.js",
    "test:e2e:coverage": "node scripts/generate-renderer-coverage.js --run",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:integration": "playwright test tests/integration",
    "test:update-snapshots": "playwright test --update-snapshots",
    "test:mutation": "stryker run",
    "test:watch": "vitest --config vitest.config.js",
    "coverage": "npm run test:unit:coverage && npm run test:e2e:coverage",
    "report:merge": "node scripts/merge-coverage.js",
    "lint:security": "eslint main.js preload.js \"src/**/*.js\" marqam.html",
    "postinstall": "playwright install chromium"
  },
  "build": {
    "appId": "com.marqam.app",
    "productName": "Marqam",
    "files": [
      "marqam.html",
      "main.js",
      "preload.js",
      "src/**/*.js",
      "icon.ico",
      "icon.png",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Marqam",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "include": "build/installer.nsh",
      "warningsAsErrors": false,
      "differentialPackage": false,
      "guid": "Marqam"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "icon": "icon.ico"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "icon": "icon.ico"
      }
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.7",
    "axe-core": "^4.11.4",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.0",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.0",
    "fast-check": "^4.8.0",
    "istanbul-reports": "^3.2.0",
    "jscpd": "^4.2.4",
    "jsdom": "^29.1.1",
    "marked": "^18.0.4",
    "v8-to-istanbul": "^9.3.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
