{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "json"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.js"
  },
  "coverageAnalysis": "perTest",
  "mutate": ["src/main-logic.js"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 70
  }
}
